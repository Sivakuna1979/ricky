# ============================================================
# Environment Variables — this repo contains THREE separate apps that
# happen to share one monorepo (see docs/FOODTAXI-TECHNICAL-BASELINE.md
# for why). Each app's variables are grouped below with its own header.
# Copy what you need to .env.local — NEVER commit .env.local.
# ============================================================


# ============================================================
# FOODTAXI VARIABLES (apps/web) — the food-van platform
# ============================================================

# Supabase — shared database/auth/storage backing FoodTaxi
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (Claude) — WhatsApp order parsing, menu/brand/schedule AI scans,
# AI event discovery
ANTHROPIC_API_KEY=sk-ant-...

# Email (Resend) — receipts, marketing campaigns
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@foodtaxi.co.uk

# SMS (Twilio) — order-ready texts. Optional: the app degrades gracefully
# ("SMS not configured") if these are unset.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+44...

# WhatsApp Cloud API — fully automatic AI ordering via WhatsApp
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-set-it-in-meta-too
# Legacy single-tenant fallback, used only when a business has no row in
# whatsapp_channels for its phone_number_id:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VAN_ID=

# Stripe — see docs/FOODTAXI-TECHNICAL-BASELINE.md "Payment architecture"
# for which flows are actually active. Required for the £29.99 event
# booking fee (active) and the Stripe webhook.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# FoodTaxi Business subscription (£19.99/month, 3-day free trial) — the
# Stripe recurring Price id, created once in the Stripe Dashboard. See
# docs/FOODTAXI-TECHNICAL-BASELINE.md "FoodTaxi Business subscription".
STRIPE_FOODTAXI_MONTHLY_PRICE_ID=price_...

# Google Maps / Places — live tracking map, business discovery
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_PLACES_API_KEY=your-google-places-key

# Food Standards Agency — hygiene rating lookups in business discovery
FSA_API_BASE_URL=https://api.ratings.food.gov.uk

# Companies House — business verification in discovery/claim flow
COMPANIES_HOUSE_API_KEY=your-key


# ============================================================
# AGENT PLATFORM VARIABLES (apps/agent) — separate product, NOT FoodTaxi.
# A multi-tenant WhatsApp/Telegram AI-agent SaaS. Do not touch alongside
# FoodTaxi work unless explicitly asked.
# ============================================================

# App URL of the agent app (used to build webhook + OAuth redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Cron protection for scheduled jobs runner (apps/agent/api/cron/run-jobs)
CRON_SECRET=change-me

# Stripe subscription price ids (one per paid plan) — apps/agent's own
# billing, unrelated to FoodTaxi's Stripe usage above.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Web search tool (Serper.dev compatible)
SERPER_API_KEY=

# Image generation tool (OpenAI-compatible /images endpoint)
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# Voice: speech-to-text (OpenAI-compatible /audio/transcriptions)
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1

# Voice: text-to-speech (optional, OpenAI-compatible /audio/speech)
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Google Workspace OAuth (Gmail, Calendar, Sheets, Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ============================================================
# YOUTUBE VARIABLES (apps/youtube) — separate product, NOT FoodTaxi.
# Automated YouTube channel management. Do not touch alongside FoodTaxi
# work unless explicitly asked.
# ============================================================

# App URL of the youtube automation app
NEXT_PUBLIC_APP_URL=http://localhost:3002

# AES-256-GCM key for encrypting stored provider API keys + OAuth tokens.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Redis (BullMQ job queue) shared by the Next.js app and the worker process
REDIS_URL=redis://localhost:6379

# Worker tuning (optional)
WORKER_CONCURRENCY_RENDER=1
WORKER_CONCURRENCY_LIGHT=5
THUMBNAIL_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Note: GOOGLE_CLIENT_ID/SECRET, CRON_SECRET and RESEND_API_KEY above are
# reused by apps/youtube. Per-provider AI/TTS/image/stock-media keys are
# NOT environment variables — they're added per-user, encrypted, from the
# app's Provider Settings dashboard page.
