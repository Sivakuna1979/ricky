# ── Data providers (server-only — never prefix with NEXT_PUBLIC_) ─────────────
# Leave all unset to run in DEMO mode (Apple demo dataset, clearly labelled).

# SEC EDGAR — FREE primary-source financials, profiles, filings and US ticker search.
# SEC requires a descriptive User-Agent with contact details: "App name contact@email"
SEC_USER_AGENT=
# Prices/quotes (optional; without one, valuation sections show "Data unavailable")
ALPHA_VANTAGE_API_KEY=      # free tier available (weekly price history)
FMP_API_KEY=                # paid; daily prices, quotes, estimates, earnings
# Which configured provider wins per capability
DATA_PROVIDER_PRIORITY=sec-edgar,fmp,alpha-vantage

# ── Accounts (Supabase) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # server-only: used by the alerts cron job
# Plan applied to everyone when auth is NOT configured (demo): free | premium | professional
DEMO_PLAN=professional

# ── AI assistant ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # without it the assistant uses rules-based answers

# ── Scheduled jobs ───────────────────────────────────────────────────────────
CRON_SECRET=

# ── Billing (Stripe) — Premium: 3 months free, then £9.99/month ──────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=       # price ID of a £9.99 GBP monthly recurring price
