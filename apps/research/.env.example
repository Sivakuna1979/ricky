# ── Data providers (server-only — never prefix with NEXT_PUBLIC_) ─────────────
# Leave all unset to run in DEMO mode (Apple demo dataset, clearly labelled).
FMP_API_KEY=
# Required by SEC EDGAR: "App name contact@email"
SEC_USER_AGENT=
# Which configured provider wins per capability
DATA_PROVIDER_PRIORITY=fmp,sec-edgar

# ── Planned (phases 10–15) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
