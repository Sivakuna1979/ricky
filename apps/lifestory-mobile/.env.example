# Copy to .env and fill in. These are bundled into the app, so only public keys go here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=https://your-lifestory-api.vercel.app
# RevenueCat public SDK keys (Project settings → API keys). Leave empty to test without payments.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
