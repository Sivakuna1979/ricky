# ============================================================
# YouTube Channel Automation — Environment Variables
# Copy to .env.local (web app) and to the worker host's env — NEVER commit
# .env.local. See SETUP.md for how to obtain each value.
# ============================================================

# --- Supabase (shared project, see SUPABASE_SETUP.md) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Secret encryption (AES-256-GCM key for stored API keys + OAuth tokens) ---
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Google OAuth (YouTube Data API) — see GOOGLE_CLOUD_SETUP.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Redis (BullMQ job queue) — Railway/Upstash/Render Redis ---
REDIS_URL=redis://localhost:6379

# --- Cron protection (Vercel Cron sends this as a Bearer header automatically
# once the env var is set on the Vercel project) ---
CRON_SECRET=change-me

# --- Email notifications (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=automation@yourdomain.com

# --- Worker tuning (optional) ---
WORKER_CONCURRENCY_RENDER=1
WORKER_CONCURRENCY_LIGHT=5
THUMBNAIL_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ============================================================
# Provider API keys are NOT set as environment variables — they are added
# per-user, encrypted, from the Provider Settings page in the dashboard
# (script/research AI, TTS, image generation, stock media). This keeps the
# app usable by multiple users each with their own billing, and means no
# vendor key ever needs to live in this file or in Vercel's env UI.
# ============================================================
