{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/enqueue-production-run", "schedule": "0 6 * * *" },
    { "path": "/api/cron/enqueue-production-run", "schedule": "0 14 * * *" },
    { "path": "/api/cron/poll-uploads", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/sync-analytics", "schedule": "0 * * * *" }
  ]
}
